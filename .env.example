# Business Manager - Environment Variables Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# ==================================
# GOOGLE OAUTH CONFIGURATION
# ==================================
# Get your OAuth Client ID from: https://console.cloud.google.com/apis/credentials
# Required for: Cloud sync, Google Drive integration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ==================================
# AI INTEGRATION (OPTIONAL)
# ==================================
# Google Gemini API Key for AI features
# Get from: https://makersuite.google.com/app/apikey
# Required for: AI Insights, SQL Assistant, Smart Analytics
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ==================================
# APPLICATION CONFIGURATION
# ==================================
# Environment: development | production | staging
VITE_ENV=production

# Application Name (used in PWA manifest)
VITE_APP_NAME=Business Manager

# Version tracking
VITE_APP_VERSION=1.2.0

# ==================================
# OPTIONAL: ANALYTICS & MONITORING
# ==================================
# If you want to add external analytics (e.g., Google Analytics, Mixpanel)
# VITE_ANALYTICS_ID=your_analytics_id_here

# Error tracking (e.g., Sentry DSN)
# VITE_SENTRY_DSN=your_sentry_dsn_here

# ==================================
# FEATURE FLAGS (OPTIONAL)
# ==================================
# Enable/disable features without code changes
VITE_ENABLE_DEV_MODE=false
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_AUTO_BACKUP=true

# ==================================
# DEPLOYMENT CONFIGURATION
# ==================================
# Base URL for the application (use '/' for root deployment)
VITE_BASE_URL=/

# API endpoint if you add a backend later
# VITE_API_BASE_URL=https://api.yourdomain.com

# ==================================
# NOTES
# ==================================
# 1. All VITE_* variables are exposed to the client-side code
# 2. Do not store sensitive secrets here that shouldn't be public
# 3. Restart dev server after changing environment variables
# 4. For production, set these in your hosting platform (Vercel, Netlify, etc.)
